# Database Configuration
# Local development: postgresql+asyncpg://postgres:postgres@localhost:5432/sahayak
# Docker development: postgresql+asyncpg://postgres:postgres@db:5432/sahayak
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sahayak

# LLM & Embedding API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
VOYAGE_API_KEY=your-voyage-api-key-here

# Security
ADMIN_TOKEN=sahayak-dev-admin-secret-token

# App config
ENVIRONMENT=development
PORT=8000
