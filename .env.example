# Sahayak environment template. Copy to .env and fill in.
#
# IMPORTANT: nothing in the application auto-loads this file -- there is no
# python-dotenv call anywhere. `make up` passes it to docker-compose via
# --env-file, but if you run uvicorn/alembic/ingest directly you must export it
# yourself:
#
#     set -a && . ./.env && set +a
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These credentials and the 5433 host port match infra docker-compose.yml.
# Inside the compose network the host is `db` on port 5432 instead.
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak_password@localhost:5433/sahayak

# ---------------------------------------------------------------------------
# Redis (rate limiter). Buckets survive API restarts, so this must be reachable.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Whether to allow traffic through when Redis is unreachable. true = fail open.
RATE_LIMIT_FALLBACK_OPEN=true

# ---------------------------------------------------------------------------
# Security -- BOTH are mandatory. They have no defaults by design: the app
# refuses to start with "CRITICAL SECURITY CONFIGURATION ERROR" if either is
# empty, so a deployment can never silently run with a guessable secret.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-different-long-random-string

# ---------------------------------------------------------------------------
# LLM & embeddings
# ---------------------------------------------------------------------------
# Provider priority for BOTH chat and embeddings: Gemini, then Anthropic/Voyage,
# then the mocks. Set ONE of the two blocks below.
#
# Without any key the app falls back to MockClaudeClient and MockEmbedder: chat
# answers and semantic search are FABRICATED and must never be treated as a
# baseline. See EVALS.md.

# --- Option 1: Google Gemini (one key covers chat AND embeddings) ------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the width of the chunks.embedding pgvector column. Changing it
# means migrating that column and re-ingesting the entire corpus.
GEMINI_EMBEDDING_DIM=1024

# --- Option 2: Anthropic + Voyage -------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
