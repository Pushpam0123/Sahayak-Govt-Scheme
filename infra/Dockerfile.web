FROM node:20-alpine

WORKDIR /app/web

# Copy package files relative to build context (monorepo root)
COPY web/package*.json ./

RUN npm install

# Copy monorepo code
COPY . /app

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Run Next.js dev server, exposing to host
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
